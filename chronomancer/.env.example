# Copy to .env and fill in. Never commit .env.

# --- Core ---
# Set to 1 only for local development (enables the fake dev login and non-HTTPS cookies).
CHRONOMANCER_DEV=1
# Required when CHRONOMANCER_DEV is not 1. Use a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///./chronomancer.db
# Where players reach this app. Used for the links the bot posts. No trailing slash.
PUBLIC_BASE_URL=http://localhost:8000

# --- Discord (create the app in the Discord Developer Portal) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a Redirect URL registered under OAuth2 in the portal.
# Defaults to PUBLIC_BASE_URL + /auth/callback.
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
# Optional: a test server's ID. Slash commands then sync to it instantly instead of globally
# (global sync can take a while to appear). Leave empty in production.
DISCORD_DEV_GUILD_ID=

# --- Switches (optional) ---
# CHRONOMANCER_BOT=0         run the website without connecting the Discord bot
# CHRONOMANCER_BACKGROUND=0  disable the background loop (auto-confirm and message delivery)
