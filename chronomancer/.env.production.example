# Production settings for the server. Copy to .env on the VM and fill in. Never commit .env.
# Plain KEY=value lines: no quotes, no spaces around the =.

# The address people use, without https:// . Its DNS A record must point at this server.
# No domain? Use <your-ip-with-dashes>.sslip.io, for example 34-123-45-67.sslip.io
SITE_ADDRESS=chronomancer.example.com
# The same address with https:// and no trailing slash. The bot puts links to it in Discord.
PUBLIC_BASE_URL=https://chronomancer.example.com

# A long random string that signs login cookies. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# From the Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: defaults to PUBLIC_BASE_URL/auth/callback. It must also be listed under OAuth2 > Redirects in the portal.
# DISCORD_REDIRECT_URI=https://chronomancer.example.com/auth/callback

# Optional: also copy each nightly backup to this Google Cloud Storage bucket (needs gcloud on the VM).
# BACKUP_BUCKET=my-chronomancer-backups

# Do NOT set CHRONOMANCER_DEV here: it turns on a fake login and non-HTTPS cookies.
# Leave DISCORD_DEV_GUILD_ID empty so slash commands sync to every server.
