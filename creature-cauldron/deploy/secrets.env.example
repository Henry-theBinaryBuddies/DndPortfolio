# Copy this file to C:\cauldron\secrets.env (OUTSIDE the project) and fill it in. Never commit the real file.
# Lines are KEY=VALUE, no quotes. deploy\run-server.ps1 reads them into the server's environment.

# The Anthropic API key made for this app. Make a NEW key just before launch, in a workspace with a spend limit.
ANTHROPIC_API_KEY=

# Optional: anything below overrides the production defaults in run-server.ps1.
# CAULDRON_DAILY_CAP=100
# CAULDRON_IP_PER_MINUTE=3
# CAULDRON_IP_PER_HOUR=10
# CAULDRON_MAX_CR=17
# CAULDRON_ALLOWED_ORIGINS=https://creaturecauldron.com
# CAULDRON_DATABASE=C:\cauldron\data\cauldron.sqlite3
