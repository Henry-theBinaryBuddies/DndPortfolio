# Copy this file to /etc/cauldron/secrets.env (OUTSIDE the project) with `sudo install -m 600`, then fill it in. Never commit the real file.
# Lines are KEY=VALUE, no quotes. systemd reads the file as root and hands the values to the server's environment.

# The Anthropic API key made for this app. Make a NEW key just before launch, in a workspace with a spend limit.
ANTHROPIC_API_KEY=

# Optional: anything below overrides the production settings written in creature-cauldron.service.
# CAULDRON_DAILY_CAP=100
# CAULDRON_IP_PER_MINUTE=3
# CAULDRON_IP_PER_HOUR=10
# CAULDRON_MAX_CR=17
# CAULDRON_ALLOWED_ORIGINS=https://creaturecauldron.com
