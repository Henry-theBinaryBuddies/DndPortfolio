# Headers for Cloudflare Pages (read from the built site's root; see docs/DEPLOYMENT.md). `npm run preview` sends the
# same headers (vite.config.ts reads this file), so the built site can be checked locally before it goes online.
# The page loads only its own files and talks to nothing else. Portraits stay in the user's browser, so images may also
# come from data: and blob: addresses.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Scripts and styles have content hashes in their names, so they never change
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The SRD pack and the published schema keep their names when they change, so an hour
/packs/*
  Cache-Control: public, max-age=3600

# The schema is published for editors and other tools to fetch from anywhere
/schemas/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
